<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:bot.views"
             BackgroundImageSource="fondo.jpg"
             x:Class="bot.views.Chat"
             Title="Chat">
    <ContentPage.Resources>
        <local:MessageTypeToColorConverter x:Key="MessageTypeToColorConverter" />
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Menú"
                     Clicked="OnMenuClicked" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*,Auto"
          Margin="0"
          Padding="10">
        <Label Text="Chat"
               Grid.Row="0"
               FontSize="25"
               TextColor="Black"
               FontAttributes="Bold"
               Margin="0,0,0,5" />
        <Frame Grid.Row="1"
               BackgroundColor="#65000000"
               BorderColor="Black"
               CornerRadius="15"
               Padding="5">
            <CollectionView x:Name="chatCollectionView"
                            ItemsSource="{Binding Messages }">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,Auto,*"
                              Padding="1"
                              Margin="0">
                            <Label Grid.Column="0"
                                   Text="{Binding ChatFrom}"
                                   Margin="0"
                                   FontSize="18"
                                   TextColor="{Binding MessageType, Converter={StaticResource MessageTypeToColorConverter}}" />
                            <Label Grid.Column="1"
                                   Text="{Binding Separador} "
                                   Margin="0"
                                   FontSize="18"
                                   TextColor="{Binding MessageType, Converter={StaticResource MessageTypeToColorConverter}}" />
                            <Label Grid.Column="2"
                                   FontSize="18"
                                   Margin="0"
                                   Text="{Binding ChatMessage}"
                                   TextColor="{Binding MessageType, Converter={StaticResource MessageTypeToColorConverter}}" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMessageTapped"
                                                      CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Frame>
        <Grid Grid.Row="2"
              ColumnDefinitions="*, Auto"
              Margin="0,10,0,0">
            <Frame Grid.Column="0"
                   BackgroundColor="Transparent"
                   BorderColor="Black"
                   CornerRadius="15"
                   Padding="5">
                <Grid ColumnDefinitions="Auto,Auto,*">
                    <Entry Grid.Column="0"
                           Text="{Binding Playerchat}"
                           TextColor="Black"
                           FontSize="16"
                           FontAttributes="Bold" />
                    <Label Grid.Column="1"
                           Text=": "
                           TextColor="Black"
                           VerticalOptions="Center" />
                    <Entry Grid.Column="2"
                           Text="{Binding Smschat}"
                           TextColor="Black"
                           FontSize="14"
                           Placeholder="Enter your message" />
                </Grid>
            </Frame>
            <ImageButton Grid.Column="1"
                         Source="enviarmensaje.png"
                         BackgroundColor="Transparent"
                         WidthRequest="30"
                         HeightRequest="30"
                         Command="{Binding ComandoEnviarpm}" />
        </Grid>
    </Grid>
</ContentPage>